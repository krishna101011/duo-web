# Duo Tracker configuration
# Copy this file to .env and fill in the values.

# Application environment: development | production
APP_ENV=development

# Secret key for encrypting AI API keys in the database.
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=replace-with-a-long-random-secret

# SQLite database path (relative to project root)
DATABASE_URL=sqlite:///./duo_tracker.db

# Server host and port
HOST=127.0.0.1
PORT=8000

# Optional logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional seed/default AI provider.
# These values are NEVER exposed to the browser.
# They only populate slot 1 on first run (when the database is empty).
AI_DEFAULT_PROVIDER=OpenAI
AI_DEFAULT_BASE_URL=https://api.openai.com/v1
AI_DEFAULT_MODEL=gpt-4o-mini
AI_DEFAULT_KEY=

# Examples for other providers (configure via Settings UI after first run):
# Groq:   base_url=https://api.groq.com/openai/v1   model=llama-3.1-70b-versatile
# xAI:    base_url=https://api.x.ai/v1              model=grok-3-mini
# Gemini: base_url=https://generativelanguage.googleapis.com/v1beta/openai  model=gemini-2.0-flash

# Server-admin only. Keep false in multi-tracker deployments.
ALLOW_GLOBAL_BACKUPS=false
